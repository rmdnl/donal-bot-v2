[Unit]
Description=DONAL Bot Pro (Binance multi-regime trading bot)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/donal-bot-pro
Environment="PATH=/home/ubuntu/donal-bot-pro/venv/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/donal-bot-pro/venv/bin/python main.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
